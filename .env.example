# Copy this file to .env for local runs. Never commit .env.
# Real environment variables win over this file.

# Optional. Without it the writer uses the safe offline templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Leave empty until previews look right and the configs are verified.
ENABLE_QUEUEING=

# Buffer GraphQL API. Key: https://publish.buffer.com/settings/api
# Ids come from: python scripts/check_buffer.py
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
BUFFER_CHANNEL_FB=
BUFFER_CHANNEL_IG=
# Optional ISO-8601 UTC timestamp. Empty = Buffer's next queue slot.
BUFFER_DUE_AT=

# Public HTTPS base URL for the reviewed image, e.g.
# https://yourname.github.io/your-repo/posts
PUBLIC_IMAGE_BASE_URL=
